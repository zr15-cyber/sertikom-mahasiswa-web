<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manajemen User</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="container flex-between">
        <div class="navbar-brand">Sertikom Admin</div>
        <div class="navbar-user">
          <div class="navbar-nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/users" class="active">User</a>
            <a href="/admin/documents">Dokumen</a>
            <a href="/admin/logs">Log</a>
            <a href="/logout">Logout</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="container page-content">
      <div class="page-header">
        <h2>Manajemen User</h2>
      </div>

      <div class="card">
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Nama</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (!users || users.length === 0) { %>
                <tr><td colspan="4">Belum ada data user.</td></tr>
              <% } else { %>
                <% users.forEach(userItem => { %>
                  <tr>
                    <td><%= userItem.name %></td>
                    <td><%= userItem.email %></td>
                    <td>
                      <select data-user-id="<%= userItem.id %>" data-type="role">
                        <option value="user" <%= userItem.role === 'user' ? 'selected' : '' %>>user</option>
                        <option value="admin" <%= userItem.role === 'admin' ? 'selected' : '' %>>admin</option>
                      </select>
                    </td>
                    <td>
                      <select data-user-id="<%= userItem.id %>" data-type="status">
                        <option value="pending" <%= userItem.status === 'pending' ? 'selected' : '' %>>pending</option>
                        <option value="active" <%= userItem.status === 'active' ? 'selected' : '' %>>active</option>
                        <option value="banned" <%= userItem.status === 'banned' ? 'selected' : '' %>>banned</option>
                      </select>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <script src="/js/main.js"></script>
  </body>
</html>
