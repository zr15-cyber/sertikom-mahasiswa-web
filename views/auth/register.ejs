<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Sertikom</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="auth-wrapper">
      <div class="card auth-card">
        <h2>Masuk ke Akun</h2>

        <% if (success_msg && success_msg.length) { %>
          <div class="alert alert-success"><span class="alert-icon">✓</span><span><%= success_msg %></span></div>
        <% } %>

        <% if (error_msg && error_msg.length) { %>
          <div class="alert alert-error"><span class="alert-icon">!</span><span><%= error_msg %></span></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="form-group">
            <label for="email">Email</label>
            <input id="email" type="email" name="email" placeholder="contoh@email.com" required />
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input id="password" type="password" name="password" placeholder="Masukkan password" required />
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
        </form>

        <div class="divider"><span>atau</span></div>
        <a href="/auth/google" class="btn btn-google">Masuk dengan Google</a>

        <p>Belum punya akun? <a href="/register">Daftar sekarang</a></p>
      </div>
    </div>
  </body>
</html>
