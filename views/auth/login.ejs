<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sertikom Mahasiswa</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="container flex-between">
        <div class="navbar-brand">Sertikom</div>
        <div class="navbar-nav">
          <a href="/login">Login</a>
          <a href="/register">Daftar</a>
        </div>
      </div>
    </nav>

    <main class="container hero">
      <div class="hero-grid">
        <div class="hero-content">
          <h1>Platform verifikasi dokumen mahasiswa modern.</h1>
          <p>
            Kelola proses upload, verifikasi, jadwal, dan notifikasi mahasiswa dalam satu aplikasi yang ringkas dan responsif.
          </p>
          <div class="hero-buttons">
            <a href="/register" class="btn btn-primary btn-lg">Buat Akun</a>
            <a href="/login" class="btn btn-secondary btn-lg">Login</a>
          </div>
        </div>

        <div class="card">
          <h3>Fitur utama</h3>
          <ul class="feature-list">
            <li>Registrasi & login</li>
            <li>Login dengan Google</li>
            <li>Upload dokumen</li>
            <li>Verifikasi admin</li>
            <li>Jadwal kegiatan</li>
            <li>Notifikasi</li>
          </ul>
        </div>
      </div>
    </main>
  </body>
</html>
